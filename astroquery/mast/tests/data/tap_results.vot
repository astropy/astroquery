    </DESCRIPTION>
   </FIELD>
   <FIELD ID="epos_logg" datatype="float" name="epos_logg" ucd="stat.error;phys.gravity;stat.max" unit="cm.s**-2">
    <DESCRIPTION>
     Positive error for stellar surface gravity in cgs units (logg)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="eneg_lum" datatype="float" name="eneg_lum" ucd="stat.error;phys.luminosity;stat.min" unit="solLum">
    <DESCRIPTION>
     Negative error for stellar luminosity in solar luminosities (lum)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="epos_lum" datatype="float" name="epos_lum" ucd="stat.error;phys.luminosity;stat.max" unit="solLum">
    <DESCRIPTION>
     Positive error for stellar luminosity in solar luminosities (lum)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="eneg_dist" datatype="float" name="eneg_dist" ucd="stat.error;pos.distance;stat.min" unit="pc">
    <DESCRIPTION>
     Negative error for distance in parsecs (d)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="epos_dist" datatype="float" name="epos_dist" ucd="stat.error;pos.distance;stat.max" unit="pc">
    <DESCRIPTION>
     Positive error for distance in parsecs (d)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="distflag" arraysize="*" datatype="char" name="distflag" ucd="meta.ref;pos.distance">
    <DESCRIPTION>
     Flag to identify the source of the object's distance (one of:
     NULL or bj2018 or tgas or hip; see DOI = 10.3847/1538-3881/ab3467
     for further information)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="eneg_teff" datatype="float" name="eneg_teff" ucd="stat.error;phys.temperature.effective;stat.min" unit="K">
    <DESCRIPTION>
     Negative error for effective temperature in Kelvin (teff)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="epos_teff" datatype="float" name="epos_teff" ucd="stat.error;phys.temperature.effective;stat.max" unit="K">
    <DESCRIPTION>
     Positive error for effective temperature in Kelvin (teff)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="teffflag" arraysize="*" datatype="char" name="teffflag" ucd="meta.ref;phys.temperature.effective">
    <DESCRIPTION>
     Flag to identify the source of the object's effective temperature
     (teff; see Table 6 of DOI = 10.3847/1538-3881/ab3467 for further
     information)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="gaiabp" datatype="float" name="gaiabp" ucd="phot.mag;em.opt.B" unit="mag">
    <DESCRIPTION>
     GAIA DR2 BP magnitude (min: -25; max: 50)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="e_gaiabp" datatype="float" name="e_gaiabp" ucd="stat.error;phot.mag" unit="mag">
    <DESCRIPTION>
     Uncertainty in GAIA DR2 BP magnitude (gaiabp; min: 0; max: 50)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="gaiarp" datatype="float" name="gaiarp" ucd="phot.mag;em.opt.R" unit="mag">
    <DESCRIPTION>
     GAIA DR2 RP magnitude (min: -25; max: 50)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="e_gaiarp" datatype="float" name="e_gaiarp" ucd="stat.error;phot.mag" unit="mag">
    <DESCRIPTION>
     Uncertainty in GAIA DR2 RP magnitude (gaiarp; min: 0; max: 50)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="gaiaqflag" datatype="int" name="gaiaqflag" ucd="meta.code.qual">
    <DESCRIPTION>
     Flag to identify the quality of the GAIA astrometric and
     photometric information (-1 for insufficient info; 0 for poor-
     quality Gaia info; 1 for good-quality Gaia info)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="vmagflag" arraysize="*" datatype="char" name="vmagflag" ucd="meta.ref;phot.mag;em.opt.V">
    <DESCRIPTION>
     Flag to identify the source of the object's V magnitude (vmag;
     see Table 6 of DOI = 10.3847/1538-3881/ab3467 for further
     information)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="bmagflag" arraysize="*" datatype="char" name="bmagflag" ucd="meta.ref;phot.mag;em.opt.B">
    <DESCRIPTION>
     Flag to identify the source of the object's B magnitude (bmag;
     see Table 6 of DOI = 10.3847/1538-3881/ab3467 for further
     information)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="splists" arraysize="*" datatype="char" name="splists" ucd="meta.code">
    <DESCRIPTION>
     Flag to identify if the object is in a specially curated list
     (one of: NULL or cooldwarfs_v8 or hotsubdwarfs_v8; see DOI =
     10.3847/1538-3881/ab3467 for further information)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="e_ra" datatype="double" name="e_ra" ucd="stat.error;pos.eq.ra" unit="mas">
    <DESCRIPTION>
     Error in right ascension in mas (ra; min: 0)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="e_dec" datatype="double" name="e_dec" ucd="stat.error;pos.eq.dec" unit="mas">
    <DESCRIPTION>
     Error in declination in mas (dec; min: 0)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="ra_orig" datatype="double" name="ra_orig" ucd="pos.eq.ra" unit="deg">
    <DESCRIPTION>
     Right ascension from original catalog in decimal degrees (min: 0;
     max: 360)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="dec_orig" datatype="double" name="dec_orig" ucd="pos.eq.dec" unit="deg">
    <DESCRIPTION>
     Dec from original catalog in decimal degrees (min: -90; max: 90)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="e_ra_orig" datatype="double" name="e_ra_orig" ucd="stat.error;pos.eq.ra" unit="mas">
    <DESCRIPTION>
     Error in ra_orig in mas (min: 0)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="e_dec_orig" datatype="double" name="e_dec_orig" ucd="stat.error;pos.eq.dec" unit="mas">
    <DESCRIPTION>
     Error in dec_orig in mas (min: 0)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="raddflag" datatype="int" name="raddflag" ucd="meta.code">
    <DESCRIPTION>
     Flag to identify the luminosity class of the object based on the
     object's stellar radius (-1 for insufficient information; 0 for
     giant; 1 for dwarf)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="wdflag" datatype="int" name="wdflag" ucd="meta.code">
    <DESCRIPTION>
     Flag to identify whether the object falls within the GAIA
     photometric white dwarf region (-1 for insufficient information;
     0 for no; 1 for yes)
    </DESCRIPTION>
   </FIELD>
   <FIELD ID="objid" datatype="long" name="objid" ucd="meta.record">
    <DESCRIPTION>
